# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cppdsa
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cppdsa

# Backend API Service
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000

# Grader Integration
GRADER_PORT=4100
GRADER_HOST=0.0.0.0
GRADER_URL=http://localhost:4100
GRADER_SECRET=dev-grader-secret

# Seed Lecturer Account
SEED_LECTURER_EMAIL=lecturer@cppdsa.local
SEED_LECTURER_PASSWORD=ChangeMe123!

# Frontend Web Service
WEB_PORT=3000
WEB_HOST=0.0.0.0

# Payload Size Limits (bytes / counts)
MAX_STUDENT_CODE_BYTES=65536
MAX_TEMPLATE_BYTES=65536
MAX_TEST_CASE_BYTES=1048576
MAX_TEST_CASES_PER_ASSIGNMENT=50
MAX_CSV_ROWS=500

# Grader Performance & Throttling (Optimized for Render Free Tier 0.15 CPU / 512MB)
GRADER_CONCURRENCY=1
GRADER_WALL_FACTOR=10
COMPILE_TIMEOUT_MS=15000
COMPILE_CPU_LIMIT_S=10
GRADER_MEMORY_BUDGET_MB=400
ENABLE_PCH=true
ENABLE_CGROUP_LOGGING=false

# API Rate Limits
GLOBAL_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
