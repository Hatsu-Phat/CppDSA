# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cppdsa
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cppdsa

# Backend API Service
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000

# Grader Integration
GRADER_PORT=4100
GRADER_HOST=0.0.0.0
GRADER_URL=http://localhost:4100
GRADER_SECRET=dev-grader-secret

# Seed Lecturer Account
SEED_LECTURER_EMAIL=lecturer@cppdsa.local
SEED_LECTURER_PASSWORD=ChangeMe123!

# Frontend Web Service
WEB_PORT=3000
WEB_HOST=0.0.0.0

# Payload Size Limits (bytes / counts)
MAX_STUDENT_CODE_BYTES=65536
MAX_TEMPLATE_BYTES=65536
MAX_TEST_CASE_BYTES=1048576
MAX_TEST_CASES_PER_ASSIGNMENT=50
MAX_CSV_ROWS=500
MAX_STATEMENT_PDF_BYTES=10485760

# Problem Statement PDF Storage (Google Drive or Local directory)
STATEMENT_STORAGE=local
STATEMENT_LOCAL_DIR=./data/statements
GDRIVE_CLIENT_ID=fake-gdrive-client-id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=fake-gdrive-client-secret
GDRIVE_REFRESH_TOKEN=fake-gdrive-refresh-token
GDRIVE_FOLDER_ID=fake-gdrive-folder-id

# Grader Performance & Throttling (Optimized for Render Free Tier 0.15 CPU / 512MB)
GRADER_CONCURRENCY=1
GRADER_WALL_FACTOR=10
COMPILE_TIMEOUT_MS=15000
COMPILE_CPU_LIMIT_S=10
GRADER_MEMORY_BUDGET_MB=400
ENABLE_PCH=true
ENABLE_CGROUP_LOGGING=false

# API Rate Limits & Proxy
GLOBAL_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
LOGIN_IP_RATE_LIMIT_MAX=100
TRUST_PROXY=false

# Production & Security Guards
COOKIE_SECRET=dev-cookie-secret-32-characters-minimum-key!
NODE_ENV=development
